{
  "name": "omer-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "scene:check": "tsx scripts/check-scene.ts",
    "budget:check": "tsx scripts/check-budget.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm content:check && pnpm scene:check && pnpm budget:check && pnpm test:unit",
    "blockout": "tsx scripts/build-blockout.ts",
    "art": "node scripts/art.mjs all",
    "art:preview": "node scripts/art.mjs preview",
    "assets": "tsx scripts/build-assets.ts",
    "test": "playwright test",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "node scripts/copy-basis.mjs",
    "shots": "tsx scripts/screenshots.ts",
    "covers": "tsx scripts/fetch-covers.ts",
    "perf": "tsx scripts/perf.ts",
    "posters": "tsx scripts/capture-posters.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gray-matter": "4.0.3",
    "lucide-react": "0.468.0",
    "marked": "18.1.3",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "~0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
